# Copy to .env and fill in real keys. .env is gitignored; .env.example is not.
# All repo scripts/tools load keys through lib/envfile.py — real environment
# variables always take precedence over values in this file.

# Grok (xAI) — text/vision LLM used by scripts/image_description*, scripts/audio
XAI_API_KEY=replace_with_xai_key

# OpenAI — GPT Image generation used by scripts/environment, tools/lora_data_generator
OPENAI_API_KEY=replace_with_openai_key
# Optional OpenAI routing headers (scripts/environment/openai_generate_environment_images.py)
# OPENAI_ORG_ID=
# OPENAI_PROJECT_ID=

# Gemini (Google AI) — scripts/environment/gemini_environment_briefs.py
# GEMINI_API_KEY takes precedence over GOOGLE_API_KEY
GEMINI_API_KEY=replace_with_gemini_key
# GOOGLE_API_KEY=

# Black Forest Labs (FLUX) — tools/lora_data_generator flux2-max mode
# FLUX_API_KEY takes precedence over BFL_API_KEY
FLUX_API_KEY=replace_with_bfl_key
# BFL_API_KEY=
